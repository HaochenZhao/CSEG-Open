# Copy to `.env` (not shipped) and load with: set -a && source .env && set +a
# Scripts themselves need no secrets. These vars configure HuggingFace, Ray,
# and the OpenAI-compatible judge endpoint used by CSEG-Bench.

# ── Hardware ─────────────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# ── HuggingFace (base model + tokenizer) ─────────────────────────────
HF_HOME=$HOME/.cache/huggingface
HF_HUB_CACHE=$HOME/.cache/huggingface
# Set to 1 only when workers cannot reach huggingface.co and weights are local:
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# Optional local venv (leave unset to use the current python / torchrun):
# VENV=$HOME/.venv-cseg

# ── Ray (GRPO) ───────────────────────────────────────────────────────
RAY_ADDR=127.0.0.1:6379

# ── Engine knobs ─────────────────────────────────────────────────────
VLLM_ATTENTION_BACKEND=FLASH_ATTN
TOKENIZERS_PARALLELISM=true
VERL_LOGGING_LEVEL=WARN
RAY_DEDUP_LOGS=1
NCCL_CUMEM_ENABLE=0

# ── Evaluation: serve a merged checkpoint, then run benchmark ────────
OPENAI_API_BASE=http://localhost:8012/v1
OPENAI_API_KEY=EMPTY
EVAL_MODEL=qwen3-4b-sft-grpo
JUDGE_MODEL=qwen3-4b-sft-grpo
