# Copy to `.env` and fill in. Shared with data_filter/score_trajectory.py.

# Base URL of the OpenAI-compatible server (e.g. vLLM openai.api_server).
OPENAI_API_BASE=http://localhost:8000/v1

# API key. For a local vLLM server any non-empty placeholder works.
OPENAI_API_KEY=EMPTY

# Default candidate model to benchmark (override with --model / --models).
EVAL_MODEL=qwen3-4b-sft-grpo
