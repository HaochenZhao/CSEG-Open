# training/.env — environment for the CSEG-RM training pipeline.
# Copy to `.env` and load with: set -a && source .env && set +a
# The scripts themselves need no secrets.

# ── Hardware ─────────────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# ── HuggingFace ──────────────────────────────────────────────────────
HF_HOME=$HOME/.cache/huggingface
HF_HUB_CACHE=$HOME/.cache/huggingface
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# Optional: path to a venv that provides verl==0.8.0 and vllm==0.11.0
# VENV=$HOME/.venv-cseg

# ── Ray (GRPO) ───────────────────────────────────────────────────────
RAY_ADDR=127.0.0.1:6379

# ── Engine knobs ─────────────────────────────────────────────────────
VLLM_ATTENTION_BACKEND=FLASH_ATTN
TOKENIZERS_PARALLELISM=true
VERL_LOGGING_LEVEL=WARN
RAY_DEDUP_LOGS=1
NCCL_CUMEM_ENABLE=0

# ── Evaluation ───────────────────────────────────────────────────────
OPENAI_API_BASE=http://localhost:8012/v1
OPENAI_API_KEY=EMPTY
EVAL_MODEL=qwen3-4b-sft-grpo
JUDGE_MODEL=qwen3-4b-sft-grpo
